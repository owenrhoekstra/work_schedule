// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Example:
[
  {
    "label": "run server",
    "command": "uv run python manage.py runserver",
  },
  {
    "label": "run tailwind server",
    "command": ".venv/lib/python3.14/site-packages/pytailwindcss/bin/latest/tailwindcss --input theme/static_src/src/styles.css --output theme/static/css/dist/styles.css --watch",
  },
  {
    "label": "tailscale serve",
    "command": "tailscale serve 8000",
  },
  {
    "label": "pre-commit checks",
    "command": "uv run python manage.py collectstatic --noinput && echo '── Django check ──' && uv run python manage.py check && echo '── Test suite ──' && uv run python manage.py test && echo '── Lockfile check ──' && uv lock --check && echo '── All checks passed ──'",
  },
  {
    "label": "create superuser",
    "command": "uv run python manage.py createsuperuser",
  },
  {
    "label": "flush db",
    "command": "uv run python manage.py flush",
  },
  {
    "label": "reset local db",
    "command": "uv run python scripts/reset_local_db.py && uv run python manage.py migrate && uv run python manage.py createsuperuser",
  },
]
